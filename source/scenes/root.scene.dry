// array of objects of the form {date: Date(), psr: 10, rdp: 12, ...} for each election
Q.election_records = [];
// party support records for every month
Q.party_support_records = [];
// inflation and unemployment records
Q.economic_records = [];


// State of the government
Q.president = "Nikolay Avksentyev";
// starting chancellor: Wilhelm Marx
Q.chairmanminister = "Andrei Argunov";
Q.chancellor_party = 'PSR';
Q.psr_in_government = 1;
Q.vpp_in_government = 0;
Q.kds_in_government = 1;
Q.rdp_in_government = 0;
Q.szrs_in_government = 0;

Q.in_right_coalition = 0;
